# Supabase — required for real sign-up (Google, GitHub, Apple, Yahoo, email)
# Create a project at https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase dashboard setup:
# 1. Authentication → URL Configuration → add redirect: http://localhost:5173/welcome and https://classroom-warden.vercel.app/welcome
# 2. Authentication → Providers → enable Email, Google, GitHub, Apple (Yahoo via custom OIDC if needed)
# 3. SQL Editor → run supabase/schema.sql

# Copy to .env for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables
